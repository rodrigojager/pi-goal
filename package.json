{
  "name": "@rodrigojager/pi-goal",
  "version": "0.54.8-rodrigo.1",
  "description": "Pi extension for autonomous single-objective /goal completion.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "goal",
    "automation"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && biome check . && npm run typecheck",
    "format": "biome check --write .",
    "test": "vitest run test/goal-wait.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "esbuild": "0.28.2",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.59.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigojager/pi-goal"
  }
}
